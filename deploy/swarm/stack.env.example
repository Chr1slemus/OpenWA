# ---------------------------------------------------------------------------
# Variables del stack cgswa.
#
# En Portainer: Stacks > cgswa > Environment variables (pares nombre/valor).
# Por CLI: guarda esto como .env junto al stack y usa `docker stack deploy`
#          con `set -a; source .env; set +a` antes (Swarm no lee .env solo).
#
# NO subas el archivo relleno a git.
# ---------------------------------------------------------------------------

# --- OpenWA ---
# Pepper para el hash de las API keys. Generalo UNA vez y no lo cambies:
# cambiarlo invalida todas las claves existentes.
#   openssl rand -hex 32
API_KEY_PEPPER=

# --- Bot ---
# Imagen construida en el nodo (ver README-swarm.md paso 2).
BOT_IMAGE=cgswa-bot:1.0.0

# Clave OPERATOR limitada a la sesion del bot. Se crea en el dashboard DESPUES
# del primer arranque, asi que en el primer despliegue va vacia.
OPENWA_API_KEY=

# Nombre de la sesion de WhatsApp.
OPENWA_SESSION_ID=cgs-main

# Secreto HMAC del webhook. Minimo 16 caracteres.
#   openssl rand -hex 32
# Debe ser IDENTICO al que uses al registrar el webhook.
WEBHOOK_SECRET=

# Mientras ajustas las reglas, pon aqui SOLO tu numero para que el bot no
# conteste a nadie mas. Formato JID, separados por coma. Vacio = todos.
ALLOWLIST=
BLOCKLIST=

# Horario de atencion.
BUSINESS_HOURS_ENABLED=false

# --- IA ---
# Responde solo cuando ninguna regla de rules.js coincide. Si falla o esta
# apagada, el bot cae al menu deterministico.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# Clave de OpenAI. Tratala como una contrasena: quien la tenga puede gastar de
# tu cuenta. Si alguna vez se expone (un chat, una captura, un commit),
# revocala en platform.openai.com y genera otra.
OPENAI_API_KEY=
