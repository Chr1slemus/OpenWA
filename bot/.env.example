# ---------------------------------------------------------------------------
# Configuracion del bot CGS. Copia a .env y rellena.
#   cp .env.example .env
# NUNCA subas el .env real a git.
# ---------------------------------------------------------------------------

# --- Servidor del bot ---
PORT=3000
WEBHOOK_PATH=/webhook
LOG_LEVEL=info                      # error | warn | info | debug

# --- Conexion a OpenWA ---
# Dentro de la red Docker se resuelve por nombre de contenedor.
OPENWA_BASE_URL=http://openwa-api:2785/api
# Clave OPERATOR limitada a esta sesion (NO uses la clave admin aqui).
OPENWA_API_KEY=
# Nombre de la sesion creada en OpenWA.
OPENWA_SESSION_ID=cgs-main
OPENWA_TIMEOUT_MS=15000
OPENWA_RETRIES=2

# --- Firma del webhook ---
# Debe ser IDENTICO al secret con el que registraste el webhook en OpenWA.
# Minimo 16 caracteres. Genera uno con: openssl rand -hex 32
WEBHOOK_SECRET=

# --- Politica de respuesta ---
IGNORE_GROUPS=true
IGNORE_BROADCAST=true
MARK_AS_READ=true
SIMULATE_TYPING=true
TYPING_MIN_MS=900
TYPING_MAX_MS=2200
QUOTE_ORIGINAL=false

# Durante las primeras pruebas, pon aqui SOLO tu numero para que el bot no
# conteste a nadie mas. Formato JID, separados por coma. Vacio = todos.
ALLOWLIST=
# Numeros que el bot nunca debe contestar (tu equipo interno, otros bots).
BLOCKLIST=

# --- Limites anti-baneo (no los subas sin pensarlo) ---
MAX_REPLIES_PER_CHAT=8
THROTTLE_WINDOW_MS=60000
MAX_REPLIES_GLOBAL=20

# --- Horario de atencion ---
BUSINESS_HOURS_ENABLED=false
BUSINESS_HOURS_TZ=America/Mexico_City
BUSINESS_HOURS_DAYS=1,2,3,4,5       # 1=lunes ... 7=domingo
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18

DEDUPE_SIZE=5000

# --- Respuestas con IA ---
# Solo se usa cuando NINGUNA regla de rules.js coincide. Si la IA falla o esta
# apagada, el bot cae al menu deterministico: el cliente nunca se queda sin
# respuesta por un problema del proveedor.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
# NUNCA la escribas en el codigo ni la subas a git.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_MAX_TOKENS=300
AI_TEMPERATURE=0.3
AI_TIMEOUT_MS=8000
AI_MAX_INPUT_CHARS=1000
# Vacio = usa el prompt por defecto de src/ai.js (que ya prohibe inventar
# precios, plazos y estatus, y escala a un humano cuando no sabe).
AI_SYSTEM_PROMPT=
